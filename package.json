{
  "name": "@giszhc/three-model-viewer",
  "version": "1.0.0",
  "description": "A modern, professional 3D model inspector and viewer SDK for Web applications. Features OBJ/MTL/ZIP loading, 3D measurements, dynamic dimensional bounding box, plane slicing, and high-res export.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build:lib": "vite build",
    "build:cdn": "vite build --mode cdn",
    "build": "vite build && vite build --mode cdn",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "three",
    "threejs",
    "model-viewer",
    "obj",
    "mtl",
    "zip",
    "measurement",
    "clipping",
    "bounding-box",
    "cad-viewer",
    "3d"
  ],
  "author": "giszhc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giszhc/three-model-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/giszhc/three-model-viewer/issues"
  },
  "homepage": "https://github.com/giszhc/three-model-viewer#readme",
  "type": "module",
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.2",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  }
}
